        </mxCell>

        <!-- ===================== LEGEND ===================== -->
        <mxCell id="legend" value="LEYENDA&#xa;&#xa;PK = Primary Key&#xa;FK = Foreign Key&#xa;CACHE = Campo derivado (no fuente de verdad)&#xa;UK = Unique&#xa;&#xa;——— 1 ──────────&lt; N   = Uno a muchos&#xa;——— 1 ────────── 1   = Uno a uno&#xa;&#xa;Colores por dominio:&#xa;■ Geo   ■ Personas   ■ Competición&#xa;■ Partidos   ■ Mercado   ■ Producto" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#f8fafc;strokeColor=#64748b;fontSize=11;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="2000" y="20" width="280" height="220" as="geometry" />
        </mxCell>

        <!-- ===================== NOTES ===================== -->
        <mxCell id="notes" value="REGLAS DE NEGOCIO CLAVE (Anexo A)&#xa;&#xa;• current_team_id / current_market_value = CACHE&#xa;• Sin club = sin history de club abierta + cache null&#xa;• Cesión = role=loan + on_loan_from_team_id&#xa;• Club+selección abiertos OK · 2 clubs abiertos NO&#xa;• Asistencia solo secondary_player_id (no event assist)&#xa;• substitution_out: sale=player_id · entra=secondary&#xa;• Máx. 1 SEASON.is_current por COMPETITION&#xa;• TRANSFER sincroniza HISTORY (related_history_id=destino)&#xa;• UNIQUE market_value (player, recorded_on, source)&#xa;• UNIQUE slug (locale, slug) · 1 primary por entidad+locale" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=11;fontColor=#9a3412;" vertex="1" parent="1">
