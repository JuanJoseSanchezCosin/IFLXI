        <!-- ===================== BUSINESS NOTES ===================== -->
        <mxCell id="notes" value="REGLAS DE NEGOCIO CLAVE (Anexo A) — sin cambios vs v1.1&#xa;&#xa;• current_team_id / current_market_value = CACHE&#xa;• Sin club = sin history de club abierta + cache null&#xa;• Cesión = role=loan + on_loan_from_team_id&#xa;• Club+selección abiertos OK · 2 clubs abiertos NO&#xa;• Asistencia solo secondary_player_id (no event assist)&#xa;• substitution_out: sale=player_id · entra=secondary&#xa;• Máx. 1 SEASON.is_current por COMPETITION&#xa;• TRANSFER sincroniza HISTORY (related_history_id=destino)&#xa;• UNIQUE market_value (player, recorded_on, source)&#xa;• UNIQUE slug (locale, slug) · 1 primary por entidad+locale" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=11;fontColor=#9a3412;" vertex="1" parent="1">
